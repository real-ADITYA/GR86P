[Unit]
Description=GR86 86SIM cockpit (live)
After=local-fs.target systemd-modules-load.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=__GR86P__/86DASH
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/default/gr86p

ExecStart=/usr/bin/python3 __GR86P__/86DASH/server.py --host 127.0.0.1 --port 8086 --interface ${GR86_CAN_INTERFACE}

Restart=always
RestartSec=1
KillSignal=SIGINT
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
