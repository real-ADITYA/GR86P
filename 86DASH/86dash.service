[Unit]
Description=GR86 Telemetry Dashboard
Requires=86log.service
After=local-fs.target systemd-modules-load.service 86log.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/GR86P/86DASH/86_dash
Environment=PYTHONUNBUFFERED=1
Environment=GR86_SESSIONS_DIR=/root/sessions

# 86LOG owns the GNSS serial port. The dashboard follows its current gnss.log.
# SocketCAN safely supports the logger and dashboard as simultaneous readers.
ExecStart=/usr/bin/python3 /root/GR86P/86DASH/86_dash/server.py --host 0.0.0.0 --port 8086 --gnss-log-dir /root/sessions

Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
