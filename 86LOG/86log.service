[Unit]
Description=GR86 CAN and GNSS Logger
After=local-fs.target systemd-modules-load.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gr86p/86LOG
Environment=PYTHONUNBUFFERED=1
Environment=GR86_CAN_INTERFACE=can0
Environment=GR86_CAN_BITRATE=500000
Environment=GR86_SESSIONS_DIR=/var/lib/gr86p/sessions
EnvironmentFile=-/etc/default/gr86p
StateDirectory=gr86p

# Configure the existing SocketCAN interface for the GR86 CAN bus.
ExecStartPre=-/usr/sbin/ip link set ${GR86_CAN_INTERFACE} down
ExecStartPre=/usr/sbin/ip link set ${GR86_CAN_INTERFACE} up type can bitrate ${GR86_CAN_BITRATE}

ExecStart=/usr/bin/python3 /opt/gr86p/86LOG/main.py

Restart=on-failure
RestartSec=1
KillSignal=SIGINT
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
