# the mac metadata file does NOT need to be tracked
.DS_Store

# Python runtime files
__pycache__/
*.py[cod]

# Local and exported drive data must never be committed or deployed as source
/sessions/*
!/sessions/.gitkeep
/sessions*.tar.gz

# Large maps exported from 86SIM (npm run pi:export): copied to the Pi, never committed (1 GB+)
/86DASH/web/tiles/*/
!/86DASH/web/tiles/richmond/
