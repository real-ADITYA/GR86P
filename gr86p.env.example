# Runtime settings installed as /etc/default/gr86p.
# Use a stable /dev/serial/by-id/... path for GR86_GNSS_PORT when possible.
GR86_CAN_INTERFACE=can0
GR86_CAN_BITRATE=500000
GR86_GNSS_ENABLED=1
GR86_GNSS_PORT=
GR86_GNSS_BAUDRATE=9600
GR86_GNSS_RETRY_SECONDS=2
GR86_SESSIONS_DIR=/opt/gr86p/sessions
